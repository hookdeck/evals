{
  "name": "hookdeck-evals",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "pnpm --filter @hookdeck-evals/framework check && pnpm --filter @hookdeck-evals/core test && pnpm --filter @hookdeck-evals/sandbox test && pnpm --filter @hookdeck-evals/web test",
    "eval": "pnpm --filter @hookdeck-evals/framework eval",
    "eval:dry": "pnpm --filter @hookdeck-evals/framework eval:dry",
    "eval:smoke": "pnpm --filter @hookdeck-evals/framework eval:smoke",
    "eval:force": "pnpm --filter @hookdeck-evals/framework eval:force",
    "score-only": "pnpm --filter @hookdeck-evals/framework score-only",
    "compare-snapshots": "pnpm --filter @hookdeck-evals/framework compare-snapshots",
    "test:framework": "pnpm --filter @hookdeck-evals/framework test:framework",
    "export-results": "pnpm --filter @hookdeck-evals/framework export-results",
    "typecheck": "pnpm --filter @hookdeck-evals/framework typecheck && pnpm --filter @hookdeck-evals/web typecheck",
    "web": "pnpm --filter @hookdeck-evals/web dev",
    "web:build": "pnpm --filter @hookdeck-evals/web build",
    "demo:mcp": "pnpm --filter @hookdeck-evals/framework demo:mcp",
    "demo:executor": "pnpm --filter @hookdeck-evals/framework demo:executor",
    "format": "biome check --write . && pnpm --filter @hookdeck-evals/web format",
    "format:check": "biome check . && pnpm --filter @hookdeck-evals/web format:check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "common-tags": "^1.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hookdeck-evals/core": "workspace:*",
    "@hookdeck-evals/sandbox": "workspace:*",
    "@types/common-tags": "^1.8.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@hookdeck-evals/hookdeck": "workspace:*"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "10.24"
  },
  "packageManager": "pnpm@10.24.0"
}
