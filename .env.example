# Claude Code harness and Anthropic ai-sdk experiments.
ANTHROPIC_API_KEY=

# Codex harness and OpenAI ai-sdk experiments. The default LLM judge is an
# OpenAI model, so rubric-scored evals need this key regardless of which
# harness produced the run.
OPENAI_API_KEY=

# Vercel AI Gateway. The opencode harness routes through this.
AI_GATEWAY_API_KEY=

# The evals-ci project's signing secret, from Dashboard > Settings > Secrets.
# Hookdeck signs every forwarded request with it, so a handler an agent writes
# needs it to verify `x-hookdeck-signature`. Not available on the API, so it has
# to be supplied here; scenarios that score a handler cannot pass without it.
HOOKDECK_SIGNING_SECRET=
