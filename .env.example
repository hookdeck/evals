# Copy to `.env` and fill in. `.env` is the only env file this repo reads:
# `pnpm eval` loads it explicitly with `node --env-file`. A `.env.local` is not
# read by anything here, and a second copy of a credential is worse than none,
# because the one you edit is not the one being used.
#
# Required to run anything: HOOKDECK_API_KEY, plus the key for whichever agent
# you are running, plus OPENAI_API_KEY for any judged scenario.

# The project every run is scored against. A project key for a dedicated
# `evals-ci` project, in an organisation with no production data: runs create
# and delete resources there, and reset it to pristine between runs.
HOOKDECK_API_KEY=

# That project's signing secret, from Dashboard > Settings > Project > Secrets.
# Hookdeck signs every forwarded request with it, so a handler an agent writes
# needs it to verify `x-hookdeck-signature`, and a scorer needs it to send a
# genuinely signed request. Not exposed on the API, which is why it lives here.
# Scenarios that score a handler cannot pass without it.
HOOKDECK_WEBHOOK_SECRET=

# Claude Code harness and Anthropic ai-sdk experiments.
ANTHROPIC_API_KEY=

# Codex harness and OpenAI ai-sdk experiments. The default LLM judge is an
# OpenAI model, so rubric-scored evals need this key regardless of which
# harness produced the run.
OPENAI_API_KEY=

# A project key for a dedicated Outpost project on the Hookdeck platform, for
# the Outpost scenarios. Separate from HOOKDECK_API_KEY: Outpost has its own API.
# Scenarios that need it are skipped when it is unset, so leaving it blank costs
# nothing.
#
# Use a project that holds nothing you want to keep. When this is set, every
# run of every scenario, Event Gateway ones included, deletes all Event Gateway
# resources in this project (sources, destinations, connections, transformations
# and issue triggers) before the seed and again on release, including resources
# that were there before the run. Runs also delete the tenants they create, and
# on release put the project's operator event destinations and managed config
# back as they found them.
OUTPOST_API_KEY=

# Vercel AI Gateway. The opencode harness routes through this. Not needed until
# secondary models go on the scoreboard.
AI_GATEWAY_API_KEY=

# Synthetic AWS credentials for benchmark-outpost-004 (any AKIA-shaped value works).
SEED_ACME_SQS_ACCESS_KEY=
SEED_ACME_SQS_SECRET_KEY=
